<template>
  <div class="page" style="padding-top: {{padTop}}px; padding-bottom: {{padBottom}}px; padding-left: {{padSide}}px; padding-right: {{padSide}}px">
    <div class="header">
      <text class="t-back" style="font-size: {{fs(14, fontTick)}}px" @click="back">返回</text>
      <text class="t-title" style="font-size: {{fs(19, fontTick)}}px">关于</text>
      <text class="t-back" style="font-size: {{fs(14, fontTick)}}px"></text>
    </div>

    <div class="top">
      <image class="logo" src="/common/logo.png"></image>
      <text class="name" style="font-size: {{fs(20, fontTick)}}px">棋类博弈</text>
      <text class="t-sub" style="font-size: {{fs(12, fontTick)}}px">版本 {{version}}</text>
    </div>

    <div class="info">
      <div class="info-row">
        <text class="t-sub" style="font-size: {{fs(13, fontTick)}}px">棋种</text>
        <text class="k" style="font-size: {{fs(13, fontTick)}}px">八种</text>
      </div>
      <div class="info-row">
        <text class="t-sub" style="font-size: {{fs(13, fontTick)}}px">模式</text>
        <text class="k" style="font-size: {{fs(13, fontTick)}}px">人机 / 双人</text>
      </div>
      <div class="info-row">
        <text class="t-sub" style="font-size: {{fs(13, fontTick)}}px">作者</text>
        <text class="k" style="font-size: {{fs(13, fontTick)}}px">模糊二维码byxz</text>
      </div>
    </div>

    <div class="spacer"></div>
    <div class="qr-wrap">
      <text class="t-info" style="font-size: {{fs(11, fontTick)}}px">模糊二维码byxz</text>
    </div>
  </div>
</template>

<script>
import router from '@system.router'
import { fs, ensureScale } from '../../common/core/ui'

export default {
  fs: fs,

  private: {
    padTop: 30,
    padBottom: 32,
    padSide: 18,
    version: '5.3.4',
    fontTick: 0
  },

  syncPad() {
    const app = this.$app.$def
    this.padTop = app.padTop
    this.padBottom = app.padBottom
    this.padSide = app.padSide
  },

  onInit() {
    this.syncPad();
    ensureScale(() => { this.fontTick++ })
  },

  back() {
    router.back()
  }
}
</script>

