<template>
  <div class="page">
    <div class="header">
      <text style="font-size: {{fs(14, fontTick)}}px" class="back" @click="back">返回</text>
      <text style="font-size: {{fs(19, fontTick)}}px" class="title">{{title}}</text>
      <text style="font-size: {{fs(14, fontTick)}}px" class="back" @click="openRules">规则</text>
    </div>

    <div class="rows">
      <div class="item" for="{{rows}}" tid="k" @click="tapRow($item.k)">
        <text style="font-size: {{fs(14, fontTick)}}px" class="item-label">{{$item.label}}</text>
        <text style="font-size: {{fs(13, fontTick)}}px" class="item-value">{{$item.value}}</text>
      </div>
    </div>

    <div class="spacer"></div>

    <div class="save-hint" if="{{hasSave}}">
      <text style="font-size: {{fs(12, fontTick)}}px" class="save-hint-text">检测到未完成的对局</text>
    </div>

    <div class="btn btn-quiet" style="width: 100%; margin-bottom: 7px;" if="{{hasSave}}" @click="resume">
      <text style="color: #ffffff; font-size: {{fs(14, fontTick)}}px">继续上局</text>
    </div>

    <div class="btn btn-warn" style="width: 100%; margin-bottom: 7px;" if="{{hasFun}}" @click="startFun">
      <text style="color: #ffffff; font-size: {{fs(14, fontTick)}}px">娱乐模式</text>
    </div>

    <div class="btn btn-primary" style="width: 100%; margin-bottom: 7px;" @click="start('ai')">
      <text style="color: #ffffff; font-size: {{fs(14, fontTick)}}px">人机对战</text>
    </div>

    <div class="btn" style="width: 100%;" @click="start('pvp')">
      <text style="color: #ffffff; font-size: {{fs(14, fontTick)}}px">双人对战</text>
    </div>
  </div>
</template>

<script>
import router from '@system.router'
import { fs, ensureScale } from '../../common/core/ui'
import { byKey, defaultOptions, TIME_PRESETS } from '../../common/core/games'
import { loadKey, dropKey } from '../../common/core/util'

export default {
  fs: fs,
  public: {
    game: 'ttt'
  },

  private: {
    fontTick: 0,
    title: '',
    rows: [],
    hasSave: false,
    hasFun: false,
    opt: null,
    g: null
  },

  onInit() {
    ensureScale(() => { this.fontTick++ })
    this.g = byKey(this.game)
    this.title = this.g.name
    const app = this.$app.$def
    // 沿用上次该棋种的设置，否则用默认值
    if (app.setup && app.setup.game === this.g.key) {
      this.opt = app.setup
    } else {
      this.opt = defaultOptions(this.g)
    }
    this.hasFun = this.g.modes.indexOf('fun') >= 0
    this.refresh()
  },

  onShow() {
    this.checkSave()
  },

  checkSave() {
    loadKey('fc_save_' + this.g.key, (ok, data) => {
      this.hasSave = ok && !!data
    })
  },

  refresh() {
    const o = this.opt
    const rows = []
    if (o.mode === 'ai') {
      rows.push({ k: 'level', label: 'AI 对手', value: this.g.levels[o.level - 1] })
    }
    if (this.g.key === 'wzq') {
      rows.push({ k: 'board', label: '棋盘大小', value: o.board + ' 路' })
    }
    if (this.g.key === 'jq') {
      rows.push({ k: 'variant', label: '玩法', value: o.variant === 'hidden' ? '暗棋' : '翻翻棋' })
    }
    if (this.g.key === 'wq') {
      rows.push({ k: 'judge', label: '胜负判定', value: o.judge === 'remain' ? '余子决胜' : '吃子数' })
      if (o.judge === 'remain') {
        rows.push({ k: 'target', label: '目标子数', value: o.target + ' 子' })
      }
    }
    if (this.g.key === 'fxq') {
      rows.push({ k: 'takeoff', label: '起飞点数', value: o.takeoff + ' 点' })
    }
    if (this.g.timer) {
      rows.push({ k: 'useTimer', label: '时间限制', value: o.useTimer ? '开启' : '关闭' })
      if (o.useTimer) {
        rows.push({ k: 'baseMinutes', label: '基础时间', value: o.baseMinutes + ' 分钟' })
        rows.push({ k: 'addSeconds', label: '每步加秒', value: o.addSeconds + ' 秒' })
      }
    }
    this.rows = rows
  },

  tapRow(k) {
    const o = this.opt
    this.$app.$def.tap()
    if (k === 'level') {
      o.level = o.level >= this.g.levels.length ? 1 : o.level + 1
    } else if (k === 'board') {
      o.board = o.board === 15 ? 17 : (o.board === 17 ? 19 : 15)
    } else if (k === 'variant') {
      o.variant = o.variant === 'hidden' ? 'flip' : 'hidden'
    } else if (k === 'judge') {
      o.judge = o.judge === 'capture' ? 'remain' : 'capture'
    } else if (k === 'target') {
      o.target = o.target >= 30 ? 5 : o.target + 5
    } else if (k === 'takeoff') {
      o.takeoff = o.takeoff === 6 ? 1 : (o.takeoff === 1 ? 5 : 6)
    } else if (k === 'useTimer') {
      o.useTimer = !o.useTimer
    } else if (k === 'baseMinutes') {
      const i = TIME_PRESETS.indexOf(o.baseMinutes)
      o.baseMinutes = TIME_PRESETS[(i + 1) % TIME_PRESETS.length]
    } else if (k === 'addSeconds') {
      o.addSeconds = o.addSeconds >= 30 ? 0 : o.addSeconds + 5
    }
    this.refresh()
  },

  start(mode) {
    this.$app.$def.tap()
    const o = this.opt
    o.mode = mode
    this.$app.$def.setup = o
    dropKey('fc_save_' + this.g.key)
    router.push({
      uri: 'pages/' + this.g.key,
      params: {
        game: this.g.key,
        mode: mode,
        level: '' + o.level,
        board: '' + o.board,
        variant: o.variant,
        judge: o.judge,
        target: '' + o.target,
        takeoff: '' + o.takeoff,
        useTimer: o.useTimer ? '1' : '',
        baseMinutes: '' + o.baseMinutes,
        addSeconds: '' + o.addSeconds,
        fresh: '1'
      }
    })
  },

  startFun() {
    this.$app.$def.tap()
    const o = this.opt
    o.mode = 'fun'
    this.$app.$def.setup = o
    dropKey('fc_save_' + this.g.key)
    router.push({
      uri: 'pages/' + this.g.key,
      params: {
        game: this.g.key,
        mode: 'fun',
        level: '' + o.level,
        board: '13',
        variant: o.variant,
        judge: o.judge,
        target: '' + o.target,
        takeoff: '' + o.takeoff,
        useTimer: '',
        baseMinutes: '' + o.baseMinutes,
        addSeconds: '' + o.addSeconds,
        fresh: '1'
      }
    })
  },

  resume() {
    this.$app.$def.tap()
    const app = this.$app.$def
    if (!app.setup || app.setup.game !== this.g.key) app.setup = this.opt
    router.push({
      uri: 'pages/' + this.g.key,
      params: { game: this.g.key, resume: '1' }
    })
  },

  openRules() {
    router.push({
      uri: 'pages/rules',
      params: { game: this.g.key }
    })
  },

  back() {
    router.back()
  }
}
</script>

<style>
  @import '../../common/style/base.css';

  .rows {
    width: 100%;
    flex-direction: column;
    flex-shrink: 0;
    margin-top: 6px;
  }

  .spacer {
    flex: 1;
  }

  .save-hint {
    width: 100%;
    align-items: center;
    justify-content: center;
    height: 20px;
  }

  .save-hint-text {
    font-size: 12px;
    color: #c9a86a;
  }
</style>
